# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Values here are the same dummy values each service already ships with by default,
# replace them with real values on a real host.


# Services
# --------------------
# a
# ----
AUTHENTIK_POSTGRESQL__USER=authentik # Dummy
AUTHENTIK_POSTGRESQL__PASSWORD=authentik # Dummy

AZIMUTT_POSTGRES_USER=azimutt # Dummy
AZIMUTT_POSTGRES_PASS=azimutt # Dummy

# c
# ----
CADDY_UI_USER=admin # Dummy
CADDY_UI_PASS=admin # Dummy
CADDY_UI_JWT_SECRET= # generate: hex32

CRONJOB_ORG_MYSQL_USER_MASTER=cronjoborg # Dummy
CRONJOB_ORG_MYSQL_PASS_MASTER=cronjoborg # Dummy
CRONJOB_ORG_MYSQL_USER_NODE=cronjoborg # Dummy
CRONJOB_ORG_MYSQL_PASS_NODE=cronjoborg # Dummy
CRONJOB_ORG_SESSION_TOKEN_SECRET= # generate: hex32
CRONJOB_ORG_EMAIL_VERIFICATION_TOKEN_SECRET= # generate: hex32
CRONJOB_ORG_LOST_PASSWORD_TOKEN_SECRET= # generate: hex32
CRONJOB_ORG_ACCOUNT_CONFIRMATION_TOKEN_SECRET= # generate: hex32
CRONJOB_ORG_VERP_SECRET= # generate: hex32
CRONJOB_ORG_STATUS_BADGE_TOKEN_SECRET= # generate: hex32

