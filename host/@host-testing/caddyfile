# Reverse Proxy
# --------------------
# https://caddyserver.com/docs/caddyfile

# Not published to the host,
# only reachable by other containers on the "caddy" network (e.g. caddy-ui-backend).
{
    admin 0.0.0.0:2019
    log {
        output file /var/log/caddy/access.log
    }
}

localhost {
    # Services
    # --------------------
    handle_path /changedetection/* {
        reverse_proxy host.docker.internal:7004
    }

    handle_path /dozzle/* {
        reverse_proxy host.docker.internal:8000
    }

}
