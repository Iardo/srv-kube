# Reverse Proxy
# --------------------
# https://caddyserver.com/docs/caddyfile

# Not published to the host,
# only reachable by other containers on the "caddy" network (e.g. caddy-ui-backend).
{
    admin 0.0.0.0:2019
    log {
        output file /var/log/caddy/access.log
    }
}

# Services
# --------------------
http://openhands.host-testing:7000 {
    reverse_proxy host.docker.internal:19000
}

http://openwebui.host-testing:7000 {
    reverse_proxy host.docker.internal:19001
}

http://zeroclaw.host-testing:7000 {
    reverse_proxy host.docker.internal:30000
}

