# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Values here are the same dummy values each service already ships with by default,
# replace them with real values on a real host.


# Services
# --------------------
# c
# ----
CADDY_UI_USER=admin # Dummy
CADDY_UI_PASS=admin # Dummy
CADDY_UI_JWT_SECRET=2612dc83647adb3b0b5ecff64a1444f6bda7981e0655b794a17566c7266d104b # Dummy

# i
# ----
IMMICH_POSTGRESQL_USER=immich # Dummy
IMMICH_POSTGRESQL_PASS=immich # Dummy

# p
# ----
PAPERLESS_NGX_POSTGRESQL_USER=paperlessngx # Dummy
PAPERLESS_NGX_POSTGRESQL_PASS=paperlessngx # Dummy
PAPERLESS_NGX_SECRET_KEY=218f360e36d3273dab422526cc1581a388b81605094b45cb062bd61dfca665cf # Dummy

# r
# ----
ROMM_MYSQL_USER=romm # Dummy
ROMM_MYSQL_PASS=romm # Dummy
ROMM_AUTH_SECRET_KEY=9c6d4c1ebb9fba30290830d4cabe7f9c261f772dd901205d2b667f0c65aee3e4 # Dummy

# w
# ----
WGER_POSTGRESQL_USER=wger # Dummy
WGER_POSTGRESQL_PASS=wger # Dummy
WGER_SECRET_KEY=3cb0d8547f9574e43cf9ef746815e9293ee90e22f1b3abba0b974a528ef2fd3a # Dummy

WIREGUARD_EASY_PASSWORD_HASH=$$2a$$12$$dGVzdGluZ2R1bW15aGFzaHZhbHVlMTIzNDU2 # Dummy, generate a real one with: docker run ghcr.io/wg-easy/wg-easy wgpw yourpassword
