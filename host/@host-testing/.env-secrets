# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Values here are the same dummy values each service already ships with by default,
# replace them with real values on a real host.


# Services
# --------------------
# a
# ----
AUTHENTIK_POSTGRESQL__USER=authentik # Dummy
AUTHENTIK_POSTGRESQL__PASSWORD=authentik # Dummy

# b
# ----
BUGSINK_SECRET_KEY=75470d541e1805225c82f6a252ea639891693915adb63316bcf4e7d289b736bb # Dummy
BUGSINK_CREATE_SUPERUSER=admin@example.com:admin # Dummy, format is email:password
BUGSINK_POSTGRESQL_USER=bugsink # Dummy
BUGSINK_POSTGRESQL_PASS=bugsink # Dummy

