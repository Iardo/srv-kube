# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Values here are the same dummy values each service already ships with by default,
# replace them with real values on a real host.


# Services
# --------------------
# a
# ----
ASTRAL_GITHUB_CLIENT_ID=changeme # Dummy, create a GitHub OAuth app at https://github.com/settings/developers
ASTRAL_GITHUB_CLIENT_SECRET=changeme # Dummy, from the same GitHub OAuth app

# c
# ----
CADDY_UI_USER=admin # Dummy
CADDY_UI_PASS=admin # Dummy
CADDY_UI_JWT_SECRET=6c7a47378ccc2de43848d79e698e2db93810568bdbd9d492a93fb9d22b1d750a # Dummy

# g
# ----
GITHUB_STARS_MANAGER_API_SECRET=13bd52ca6ea43e43b9f4e2a6aaa3c82652f88e633dbff3999db0b54f498cfc44 # Dummy
GITHUB_STARS_MANAGER_ENCRYPTION_KEY=77473aa2f023978df2564146a870a591b21eaefcdd330956188bff3062179b94 # Dummy

# l
# ----
LINKACE_MYSQL_USER=linkace # Dummy
LINKACE_MYSQL_PASS=linkace # Dummy
LINKACE_CACHE_PASS=linkace # Dummy

# s
# ----
SILVERBULLET_USER=admin:admin # Dummy

