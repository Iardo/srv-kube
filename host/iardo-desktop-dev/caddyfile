# Reverse Proxy
# --------------------
# https://caddyserver.com/docs/caddyfile

# Not published to the host,
# only reachable by other containers on the "caddy" network (e.g. caddy-ui-backend).
{
    admin 0.0.0.0:2019
    log {
        output file /var/log/caddy/access.log
    }
}

# Services
# --------------------
http://*.iardo-desktop-dev:7000 {
    @changedetection host changedetection.iardo-desktop-dev
    handle @changedetection {
        reverse_proxy host.docker.internal:7004
    }

    @dozzle host dozzle.iardo-desktop-dev
    handle @dozzle {
        reverse_proxy host.docker.internal:8000
    }

}
