# Principal
# --------------------
SERV=../../serv/         # INCLUDES_PATH
FILE=docker-compose.yml  # INCLUDES_FILE


# Override
# --------------------
TIMEZONE=America/Panama

# Outline
OUTLINE_DOMAIN=outline.iardoo.com

# Linkace
LINKACE_DOMAIN=linkace.iardoo.com

# Caddy
CADDY_DOMAIN=iardoo.com
CADDY_AUTO_HTTPS=true
CADDY_WEB_HTTP=80
CADDY_WEB_HTTPS=443
CADDY_CADDYFILE=../../host/iardo-vps-iardoo/caddyfile

# Dnsmasq
DNSMASQ_CONF=../../host/iardo-vps-iardoo/dnsmasq.conf


