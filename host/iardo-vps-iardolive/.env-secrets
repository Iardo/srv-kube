# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Values here are the same dummy values each service already ships with by default,
# replace them with real values on a real host.


# Services
# --------------------
# b
# ----
BESZEL_AGENT_TOKEN=changeme # Dummy, from the Hub's "Add System" dialog (or Settings > Tokens) after it's running
BESZEL_AGENT_KEY=changeme # Dummy, the public key shown in that same dialog

# c
# ----
CADDY_UI_USER=admin # Dummy
CADDY_UI_PASS=admin # Dummy
CADDY_UI_JWT_SECRET= # generate: hex32

# g
# ----
GRAFANA_ADMIN_USER=admin # Dummy
GRAFANA_ADMIN_PASSWORD=admin # Dummy

# i
# ----
INFISICAL_POSTGRESQL_USER=infisical # Dummy
INFISICAL_POSTGRESQL_PASS=infisical # Dummy
INFISICAL_ENCRYPTION_KEY= # generate: hex16
INFISICAL_AUTH_SECRET= # generate: hex32

# p
# ----
PASSBOLT_POSTGRESQL_USER=passbolt # Dummy
PASSBOLT_POSTGRESQL_PASS=passbolt # Dummy

# u
# ----
UMAMI_POSTGRESQL_USER=umami # Dummy
UMAMI_POSTGRESQL_PASS=umami # Dummy
UMAMI_APP_SECRET= # generate: hex32
UMAMI_TWO_FACTOR_ENCRYPTION_KEY= # generate: hex32

