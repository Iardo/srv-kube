# Principal
# --------------------
SERV=../../serv/         # INCLUDES_PATH
FILE=docker-compose.yml  # INCLUDES_FILE


# Override
# --------------------
TIMEZONE=America/Panama

# Gatus
GATUS_CONFIG=../../host/iardo-vps-iardolive/gatus.yml
# Untracked, host-only endpoints, merged on top of GATUS_CONFIG
GATUS_CONFIG_LOCAL=../../host/iardo-vps-iardolive/gatus.local.yml

# Caddy
CADDY_DOMAIN=iardo.live
CADDY_AUTO_HTTPS=true
CADDY_WEB_HTTP=80
CADDY_WEB_HTTPS=443
CADDY_CADDYFILE=../../host/iardo-vps-iardolive/caddyfile

# Dnsmasq
DNSMASQ_CONF=../../host/iardo-vps-iardolive/dnsmasq.conf

# Passbolt
PASSBOLT_DOMAIN=passbolt.iardo.live


# Generated
# --------------------
# The ports are auto generated running init.py
# please do not update the next configurations by hand
# --------------------
# a
# ----
AUTHENTIK_WEB_HTTP=5000
AUTHENTIK_DATABASE=5001
AUTHENTIK_CACHE=5002

# b
# ----
BESZEL_WEB_HTTP=6001

# c
# ----
CADDY_WEB_UI_HTTP=7002
CADDY_WEB_UI_API=7003

# d
# ----
DNSMASQ_DNS=8000

# g
# ----
GATUS_WEB_HTTP=11000

GRAFANA_WEB_HTTP=11001

# i
# ----
INFISICAL_WEB_HTTP=13000

# n
# ----
NTFY_WEB_HTTP=18000

# p
# ----
PASSBOLT_WEB_HTTPS=20000

# t
# ----
TERMIX_WEB_HTTP=24000

# u
# ----
UMAMI_WEB_HTTP=25000

