# Reverse Proxy
# --------------------
# https://caddyserver.com/docs/caddyfile

# Not published to the host,
# only reachable by other containers on the "caddy" network (e.g. caddy-ui-backend).
{
    admin 0.0.0.0:2019
    log {
        output file /var/log/caddy/access.log
    }
}

# Services
# --------------------
beszel.iardo.dev {
    reverse_proxy host.docker.internal:6001
}

bugsink.iardo.dev {
    reverse_proxy host.docker.internal:6002
}

kaneo.iardo.dev {
    reverse_proxy host.docker.internal:15000
}

mailpit.iardo.dev {
    reverse_proxy host.docker.internal:17000
}

outline.iardo.dev {
    reverse_proxy https://host.docker.internal:19002 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

webcheck.iardo.dev {
    reverse_proxy host.docker.internal:27000
}

woodpecker.iardo.dev {
    reverse_proxy host.docker.internal:27001
}

