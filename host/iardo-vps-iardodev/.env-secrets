# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Services
# --------------------
# a
# ----
AUTHENTIK_POSTGRESQL__USER=authentik # Dummy
AUTHENTIK_POSTGRESQL__PASSWORD=authentik # Dummy

# k
# ----
KOMODO_DATABASE_USERNAME=admin # Dummy
KOMODO_DATABASE_PASSWORD=admin # Dummy

# l
# ----
LINKACE_MYSQL_USER=linkace # Dummy
LINKACE_MYSQL_PASS=linkace # Dummy
LINKACE_CACHE_PASS=linkace # Dummy

# o
# ----
OPEN_PROJECT_POSTGRESQL_USER=openproject # Dummy
OPEN_PROJECT_POSTGRESQL_PASS=openproject # Dummy
OPEN_PROJECT_SECRET_KEY_BASE=5498b794812bfdb837b4dc0beee88d2e9b912a11ebf3a8bdd401c2763db7cf79 # Dummy

# Lets Outline users log in with authentik instead of a separate password.
# Authentik runs on this same host.
# "authentik-web" only resolves here because outline-web was joined to authentik's docker network by hand,
# see serv/outline/.env for the full explanation.
OUTLINE_OIDC_CLIENT_ID=R8BCbHN4UJd9ELrm8h1avaGF2NEavl3i9TvK2C9W # Dummy
OUTLINE_OIDC_CLIENT_SECRET=3ehAIJr1hofVpqmLFKQq16JqDrKghJPWSisfSNx61sOg5KYD4CBJDyFUzKHprPoK4w7Vi8XJM7J1p4ba0IYDqlYZmwzx8sAfxJ1WPTxO9rhv0kpSHXhRyIdusFMDGTkp # Dummy
OUTLINE_OIDC_AUTH_URI=https://localhost:5002/application/o/authorize/
OUTLINE_OIDC_LOGOUT_URI=https://localhost:5002/application/o/outline/end-session/
OUTLINE_OIDC_TOKEN_URI=http://authentik-web:9000/application/o/token/
OUTLINE_OIDC_USERINFO_URI=http://authentik-web:9000/application/o/userinfo/
OUTLINE_OIDC_DISPLAY_NAME=Authentik
