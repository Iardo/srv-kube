# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Values here are the same dummy values each service already ships with by default,
# replace them with real values on a real host.


# Services
# --------------------
# b
# ----
BESZEL_AGENT_TOKEN=changeme # Dummy, "Add System" > Token
BESZEL_AGENT_KEY=changeme # Dummy, "Add System" > Public Key

BUGSINK_SECRET_KEY= # generate: hex32
BUGSINK_CREATE_SUPERUSER=admin@example.com:admin # Do not change; email:password
BUGSINK_POSTGRESQL_USER=bugsink # Do not change
BUGSINK_POSTGRESQL_PASS=bugsink # Do not change

# c
# ----
CADDY_UI_USER=admin # Dummy
CADDY_UI_PASS=admin # Dummy
CADDY_UI_JWT_SECRET= # generate: hex32

# k
# ----
KANEO_AUTH_SECRET= # generate: hex32
KANEO_POSTGRESQL_USER=kaneo # Do not change
KANEO_POSTGRESQL_PASS=kaneo # Do not change
KANEO_S3_BUCKET= # Fill-in, see serv/kaneo/readme.md
KANEO_S3_ACCESS_KEY_ID= # Fill-in, see serv/kaneo/readme.md
KANEO_S3_SECRET_ACCESS_KEY= # Fill-in, see serv/kaneo/readme.md

# o
# ----
OUTLINE_SECRET_KEY= # generate: hex32
OUTLINE_UTILS_SECRET= # generate: hex32

# s
# ----
SILO_ROOT_PASSWORD= # generate: hex32

# w
# ----
WOODPECKER_GITHUB_CLIENT=changeme # Dummy, GitHub OAuth app -> https://github.com/settings/developers
WOODPECKER_GITHUB_SECRET=changeme # Dummy, GitHub OAuth app -> https://github.com/settings/developers
WOODPECKER_AGENT_SECRET= # generate: hex32

