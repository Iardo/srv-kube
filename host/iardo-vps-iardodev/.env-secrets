# Secrets
# --------------------
# Per-host override file, layered on top of ".env".
# Loaded LAST, so any variable set here wins over the same variable in ".env".
#
# Every variable below is prefixed with its service name to avoid two
# services silently sharing the same credential when included together.

# Services
# --------------------
# a
# ----
AUTHENTIK_POSTGRESQL__USER=
AUTHENTIK_POSTGRESQL__PASSWORD=

# d
# ----
DOCMOST_APP_SECRET=
DOCMOST_POSTGRESQL_USER=
DOCMOST_POSTGRESQL_PASS=

# k
# ----
KOMODO_DATABASE_USERNAME=
KOMODO_DATABASE_PASSWORD=

# l
# ----
LINKACE_MYSQL_USER=
LINKACE_MYSQL_PASS=
LINKACE_CACHE_PASS=

# n
# ----
N8N_POSTGRESQL_USER=
N8N_POSTGRESQL_PASS=
N8N_POSTGRESQL_USER_NON_ROOT=
N8N_POSTGRESQL_PASS_NON_ROOT=

# o
# ----
OPEN_PROJECT_POSTGRESQL_USER=
OPEN_PROJECT_POSTGRESQL_PASS=
