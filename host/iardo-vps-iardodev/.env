# Principal
# --------------------
SERV=../../serv/         # INCLUDES_PATH
FILE=docker-compose.yml  # INCLUDES_FILE


# Override
# --------------------
TIMEZONE=America/Panama

# Komodo
KOMODO_HOST=http://iardo.dev:9120
KOMODO_FIRST_SERVER_NAME=iardo-vps-iardodev

# Linkwarden
LINKWARDEN_DISABLE_REGISTRATION=true

# Open Project
OPEN_PROJECT_HTTPS=true
OPEN_PROJECT_TITLE=OpenProject
OPEN_PROJECT_HOST_NAME=project.iardo.dev
OPEN_PROJECT_HOST_NAME_ADDITIONAL='["localhost","iardo.dev"]'
OPEN_PROJECT_SELF_REGISTRATION=0

# Outline
OUTLINE_URL=https://localhost
# Caddy
CADDY_CADDYFILE=../../host/iardo-vps-iardodev/caddyfile

# Dnsmasq
DNSMASQ_CONF=../../host/iardo-vps-iardodev/dnsmasq.conf


# Generated
# --------------------
# The ports are auto generated running init.py
# please do not update the next configurations by hand
# --------------------
# komodo (reserved, always this range)
