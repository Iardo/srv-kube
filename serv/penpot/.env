# Principal
# --------------------
# https://help.penpot.app/technical-guide/configuration/
# PENPOT_SECRET_KEY comes from this host's ".env-secrets"/".env-secrets.local" (PENPOT_SECRET_KEY).

# Database
# ----
PENPOT_DATABASE_URI=postgresql://penpot-database/penpot

# Cache
# ----
PENPOT_REDIS_URI=redis://penpot-cache/0

# Network
# ----
PENPOT_HTTP_SERVER_HOST=0.0.0.0
PENPOT_PUBLIC_URI=http://localhost:5020

# Storage
# ----
ASSETS_STORAGE_BACKEND=assets-fs
PENPOT_STORAGE_ASSETS_FS_DIRECTORY=/opt/data/assets

# Telemetry
# ----
PENPOT_TELEMETRY_ENABLED=false

# Mail
# ----
PENPOT_SMTP_DEFAULT_FROM=admin@penpot.local
PENPOT_SMTP_DEFAULT_REPLY_TO=admin@penpot.local
PENPOT_SMTP_HOST=penpot-mailcatch
PENPOT_SMTP_PORT=1025
PENPOT_SMTP_SSL=false
PENPOT_SMTP_TLS=false

# Flags
# ----
PENPOT_FLAGS=enable-registration enable-login-with-password enable-smtp enable-prepl-server enable-backend-api-doc enable-webhooks disable-email-verification disable-onboarding disable-onboarding-newsletter disable-onboarding-questions disable-dashboard-templates-section
