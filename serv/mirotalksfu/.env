# Principal
# --------------------
# https://github.com/miroslavpejic85/mirotalksfu/blob/main/.env.template
# JWT_SECRET comes from this host's ".env-secrets"/".env-secrets.local"
# (MIROTALKSFU_JWT_SECRET).

NODE_ENV=production
# Set this to this host's real public IP/domain,
# WebRTC clients need it to negotiate media. Override per-host.
SFU_ANNOUNCED_IP=
SFU_LISTEN_IP=0.0.0.0
SFU_MIN_PORT=40000
SFU_MAX_PORT=40100
SERVER_LISTEN_IP=0.0.0.0
SERVER_LISTEN_PORT=3010
# Set true behind a reverse proxy (Caddy) for correct per-IP rate limiting.
TRUST_PROXY=true
CORS_ORIGIN=*
