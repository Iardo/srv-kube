# Principal
# --------------------
# APP_KEY comes from this host's ".env-secrets"/".env-secrets.local" (LINKACE_APP_KEY).

# Database
# ----
# mysql, pgsql, sqlsrv, sqlite
DB_CONNECTION=mysql

MYSQL_NAME=linkace
MYSQL_USER=linkace
MYSQL_PASS=linkace # Dummy

# Cache
# ----
REDIS_HOST=linkace-redis
REDIS_PASS=linkace # Dummy



# Additional
# --------------------
APP_DEBUG=false
