# Principal
# --------------------
# PLANE_SECRET_KEY/PLANE_LIVE_SECRET come from this host's
# ".env-secrets"/".env-secrets.local".

# Database
# ----
PLANE_POSTGRESQL_USER=plane
PLANE_POSTGRESQL_PASS=plane # Dummy

# Message Queue (RabbitMQ)
# ----
PLANE_MQ_USER=plane
PLANE_MQ_PASS=plane # Dummy

# Storage (MinIO)
# ----
PLANE_MINIO_ACCESS_KEY=plane-access-key # Dummy
PLANE_MINIO_SECRET_KEY=plane-secret-key # Dummy
