# Principal
# --------------------
# https://github.com/lancachenet/docker-compose
# (see its own README's "Settings" section for details on each of these)
#
# LANCACHE_IP / DNS_BIND_IP are this host's actual LAN IP,
# override them per-host, the defaults below are placeholders
# and almost certainly wrong for a real deployment.

USE_GENERIC_CACHE=true
LANCACHE_IP=127.0.0.1
DNS_BIND_IP=127.0.0.1
UPSTREAM_DNS=8.8.8.8
CACHE_DISK_SIZE=2000g
MIN_FREE_DISK=10g
CACHE_INDEX_SIZE=500m
CACHE_MAX_AGE=3650d
TZ=${TIMEZONE:-America/Panama}
