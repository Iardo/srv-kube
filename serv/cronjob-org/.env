# Principal
# --------------------
CJO_PROJECT_NAME=cronjob-org

# Email
# ----
SMTP_SERVER=smtp.example.com
# Email sender address and return path. '%s' in the return path will be
# replaced by a VERP token which can be used to automatically processed
# bounce emails and match them to a user account
# (e.g. to disable sending further emails to this user).
CJO_EMAIL_SENDER=cjo@localhost.com
CJO_EMAIL_RETURN_PATH=bounce+%s@bounces.example.com

# Token
# ----
# Generate one with:
#   openssl rand -hex 32
CJO_SESSION_TOKEN_SECRET=e8ece0def0a861e85084a661c6bf043a8dd47a8bedd5dd95970872f7d8263347
CJO_EMAIL_VERIFICATION_TOKEN_SECRET=a04db58f018054c4989605d94f14f74ad3b9b986a6c593a821ce1cda01af30d2
CJO_LOST_PASSWORD_TOKEN_SECRET=85999d4a1396533ce59919788cd72d3b02a6a64312baab69779a599b7705c3fd
CJO_ACCOUNT_CONFIRMATION_TOKEN_SECRET=aa630e06eddec8dd09aaac804a40c498ca5a220b11ffda6b5dd44c8a9923d3f0
CJO_VERP_SECRET=edc9ee86c40bd90249882b100cb99188a1ee4840392e623d95c1130853abf3a2
CJO_STATUS_BADGE_TOKEN_SECRET=7d168cb60ab1bb72593748a7aed874f903878ec0920695027a15d2d8ba214d6e

# Database
# ----
MYSQL_NAME_MASTER=cronjoborg_master
MYSQL_USER_MASTER=cronjoborg
MYSQL_PASS_MASTER=cronjoborg

MYSQL_NAME_NODE=cronjoborg_node
MYSQL_USER_NODE=cronjoborg
MYSQL_PASS_NODE=cronjoborg
