# Principal
# --------------------
NODE_ENV=production
DEFAULT_LANGUAGE=en_US
WEB_CONCURRENCY=1
COLLABORATION_URL=

# Generate one with:
#   openssl rand -hex 32
SECRET_KEY=f09a8712d7f9e9b3be61e7c419903b444fe0f435622e630155d303807ca07ad6   # Dummy
UTILS_SECRET=f09a8712d7f9e9b3be61e7c419903b444fe0f435622e630155d303807ca07ad6 # Dummy

# Database
# ----
DATABASE_URL=postgres://outline:outline@outline-database:5432/outline
# Pool size per-process, defaults to 0 and 5
DATABASE_CONNECTION_POOL_MIN=
DATABASE_CONNECTION_POOL_MAX=
# Uncomment if the database server does not have SSL enabled
PGSSLMODE=disable

# Cache
# ----
REDIS_URL=redis://outline-cache:6379
REDIS_COLLABORATION_URL=

# Storage
# ----
# "local" or "s3"
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
FILE_STORAGE_IMPORT_MAX_SIZE=
FILE_STORAGE_WORKSPACE_IMPORT_MAX_SIZE=



# Additional
# --------------------
# S3-compatible storage, only used when FILE_STORAGE=s3
AWS_ACCESS_KEY_ID=get_a_key_from_aws
AWS_SECRET_ACCESS_KEY=get_the_secret_of_above_key
AWS_REGION=xx-xxxx-x
AWS_S3_ACCELERATE_URL=
AWS_S3_UPLOAD_BUCKET_URL=http://s3:4569
AWS_S3_UPLOAD_BUCKET_NAME=bucket_name_here
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private
# "post" (default) or "put" (needed for Cloudflare R2)
AWS_S3_UPLOAD_METHOD=post

# Optional CloudFront CDN for attachment downloads
AWS_CLOUDFRONT_URL=
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY=

# Optional CDN for static assets (js/css/images), origin should match URL
CDN_URL=

# SSL
# ----
# Not needed here, TLS termination is handled by the outline-server proxy
SSL_KEY=
SSL_CERT=
FORCE_HTTPS=true

# Auth
# ----
# At least ONE sign-in provider below is required

# Slack
SLACK_CLIENT_ID=get_a_key_from_slack
SLACK_CLIENT_SECRET=get_the_secret_of_above_key

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra / Azure AD
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_APP_ID=

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SERVER_ID=
DISCORD_SERVER_ROLES=

# Generic OIDC
# Points at the "Outline" application/provider created in the authentik
# instance running on this same host (serv/authentik). "authentik-web" only
# resolves because outline-web was joined to authentik's docker network -
# see the "docker network connect" note in the deployment guide.
OIDC_CLIENT_ID=R8BCbHN4UJd9ELrm8h1avaGF2NEavl3i9TvK2C9W
OIDC_CLIENT_SECRET=3ehAIJr1hofVpqmLFKQq16JqDrKghJPWSisfSNx61sOg5KYD4CBJDyFUzKHprPoK4w7Vi8XJM7J1p4ba0IYDqlYZmwzx8sAfxJ1WPTxO9rhv0kpSHXhRyIdusFMDGTkp # Dummy
OIDC_AUTH_URI=https://localhost:5002/application/o/authorize/
OIDC_TOKEN_URI=http://authentik-web:9000/application/o/token/
OIDC_USERINFO_URI=http://authentik-web:9000/application/o/userinfo/
OIDC_LOGOUT_URI=https://localhost:5002/application/o/outline/end-session/
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=Authentik
OIDC_SCOPES=openid profile email

# SMTP
# ----
SMTP_SERVICE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Rate limiter
# ----
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60
# > 1 more lenient, < 1 stricter
RATE_LIMITER_MULTIPLIER=1

# Integrations
# ----
# GitHub - previews issue and pull request links
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_NAME=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# GitLab - previews issue and merge request links
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Linear - previews issue links as rich mentions
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Slack - search and posting to channels, in addition to Slack auth above
SLACK_VERIFICATION_TOKEN=your_token
SLACK_APP_ID=A0XXXXXXX
SLACK_MESSAGE_ACTIONS=true

# Figma - previews design files as rich mentions
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Dropbox - remember to whitelist your domain name in the app settings
DROPBOX_APP_KEY=

# Sentry - error and performance tracking
SENTRY_DSN=
SENTRY_TUNNEL=

# Notion - importing pages from a Notion workspace
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Iframely - previews of third-party content within links
IFRAMELY_URL=
IFRAMELY_API_KEY=

# Additional
# --------------------
# Send anonymized usage statistics to the maintainers
ENABLE_UPDATES=true
# error, warn, info, http, verbose, debug, or silly
LOG_LEVEL=info
DEBUG=http
