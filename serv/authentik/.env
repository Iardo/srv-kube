# Principal
# --------------------
# Secret and DB credentials come from this host's ".env-secrets"/".env-secrets.local".

# Database
# ----
AUTHENTIK_POSTGRESQL__HOST=authentik-database
AUTHENTIK_POSTGRESQL__NAME=authentik

# Cache
# ----
AUTHENTIK_REDIS__HOST=authentik-redis

# Email
# ----
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__HOST=localhost
AUTHENTIK_EMAIL__PORT=25
AUTHENTIK_EMAIL__FROM=authentik@localhost # Dummy
# Optionally authenticate (don't add quotation marks to your password)
AUTHENTIK_EMAIL__USERNAME=authentik # Dummy
AUTHENTIK_EMAIL__PASSWORD=authentik # Dummy



# Additional
# --------------------
# AUTHENTIK_LOG_LEVEL=trace
AUTHENTIK_ERROR_REPORTING__ENABLED=false
