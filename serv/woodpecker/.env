# Principal
# --------------------
# https://woodpecker-ci.org/docs/administration/configuration/server
WOODPECKER_OPEN=true
WOODPECKER_ADMIN=
WOODPECKER_HOST=http://localhost:8000

# Forge
# --------------------
# Enable whichever forge you use and fill in the matching OAuth client
# id/secret (registered as secrets, see docker-compose.yml). See docs for
# gitea/gitlab/bitbucket equivalents:
# https://woodpecker-ci.org/docs/administration/configuration/forges
WOODPECKER_GITHUB=true
