# Principal
# --------------------
BASE_URL=http://localhost:8000

# Caddy
# ----
# Caddy (every host here) terminates HTTPS and forwards over plain HTTP, and sends X-Forwarded-For, not X-Real-IP.
BEHIND_HTTPS_PROXY=true
USE_X_FORWARDED_FOR=true
USE_X_FORWARDED_HOST=false
USE_X_REAL_IP=false
X_FORWARDED_FOR_PROXY_COUNT=1

# Users
# ----
# Default is single-user mode, which hides every team/invite option in the
# UI. CB_ADMINS (not CB_ANYBODY): only existing Admins can invite someone by
# email, this is reachable from the internet.
SINGLE_USER=false
USER_REGISTRATION=CB_ADMINS

