# Principal
# --------------------
# APP_KEY comes from this host's ".env-secrets"/".env-secrets.local"
# (MONICA_APP_KEY). MONICA_MYSQL_USER/PASS likewise (MYSQL_RANDOM_ROOT_PASSWORD
# means there's no separate root password to manage).

APP_ENV=production
LOG_CHANNEL=stderr
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_DRIVER=sync
