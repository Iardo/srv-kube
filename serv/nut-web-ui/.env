# Principal
# --------------------
# https://github.com/superioone/nut_webgui
# UPSD_PASS comes from this host's ".env-secrets"/".env-secrets.local"
# (NUT_WEB_UI_UPSD_PASS) — it must match an existing NUT server's own
# configured password, not a value this repo generates.
#
# UPSD_ADDR/UPSD_USER are not secrets, set them per-host below.
UPSD_ADDR=
UPSD_USER=
