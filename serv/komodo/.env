# Principal
# --------------------
KOMODO_TITLE=Komodo
KOMODO_FIRST_SERVER_NAME=local
KOMODO_HOST=https://example.komodo.com
KOMODO_PATH_BACKUP=/etc/komodo/backup
KOMODO_SYNC_DIRECTORY=./../../conf/komodo

# Login
# ----
KOMODO_LOCAL_AUTH=true                 # Enable login
KOMODO_INIT_ADMIN_PASSWORD=admin       # Dummy
KOMODO_INIT_ADMIN_USERNAME=admin       # Dummy
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=false
KOMODO_DISABLE_USER_REGISTRATION=false

# Login OpenID Connect
# ----
KOMODO_OIDC_ENABLED=false
# KOMODO_OIDC_ADDITIONAL_AUDIENCES=
# KOMODO_OIDC_CLIENT_ID=
# KOMODO_OIDC_CLIENT_SECRET=
# KOMODO_OIDC_PROVIDER=https://oidc.provider.internal/application/o/komodo
# KOMODO_OIDC_REDIRECT_HOST=https://oidc.provider.external
# KOMODO_OIDC_USE_FULL_EMAIL=true

# Secret
# ----
KOMODO_JWT_SECRET=SECRET     # Dummy
KOMODO_JWT_TTL="1-day"
KOMODO_WEBHOOK_SECRET=SECRET # Dummy

# HTTPS
# ----
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

# Database
# ----
KOMODO_DATABASE_USERNAME=admin # Dummy
KOMODO_DATABASE_PASSWORD=admin # Dummy

## Logging
KOMODO_LOGGING_PRETTY=false
KOMODO_PRETTY_STARTUP_CONFIG=false

# Periphery
# ----
PERIPHERY_SERVER_ENABLED=true
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_ADDRESS=ws://komodo-core:9120
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false

# Specify the root directory used by Periphery agent.
# All your compose files and repos need to be inside this directory
# for Periphery to interact with them.
# - ROOT_DIRECTORY (/etc/komodo)
# --- ./stacks
# ------ ./my_stack_1
# ------ ./my_stack_2
# --- ./repos
# ------ ./my_repo_1
# --- ./builds
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_STACK_DIR=/etc/srv-kube

## Specify whether to disable the terminals feature
## and disallow remote shell access inside Periphery container.
PERIPHERY_DISABLE_TERMINALS=false
## Specify whether to disable the container exec / attach features
## and disallow remote container shell access.
PERIPHERY_DISABLE_CONTAINER_TERMINALS=false

# If the disk size is overreporting use one of these
# accepts comma separated list of paths.
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
# PERIPHERY_EXCLUDE_DISK_MOUNTS=/snap,/etc/repos



# Additional
# --------------------
KOMODO_DISABLE_CONFIRM_DIALOG=false
KOMODO_DISABLE_INIT_RESOURCES=false
KOMODO_TRANSPARENT_MODE=false # Allows all users to have Read level access to all resources.

# Rate Komodo polls your servers for
# status / container status / system stats / alerting.
# Options: 1-sec, 5-sec, 15-sec, 1-min, 5-min, 15-min
KOMODO_MONITORING_INTERVAL="15-sec"
# Interval at which to poll Resources for any updates / automated actions.
# Options: 5-min, 15-min, 1-hr, 2-hr, 6-hr, 12-hr, 1-day
KOMODO_RESOURCE_POLL_INTERVAL="1-hr"

# Login Github Oauth
KOMODO_GITHUB_OAUTH_ENABLED=false
# KOMODO_GITHUB_OAUTH_ID=
# KOMODO_GITHUB_OAUTH_SECRET=

# Login Google Oauth
KOMODO_GOOGLE_OAUTH_ENABLED=false
# KOMODO_GOOGLE_OAUTH_ID=
# KOMODO_GOOGLE_OAUTH_SECRET=

# AWS (Used to launch Builder instances)
KOMODO_AWS_ACCESS_KEY_ID=
KOMODO_AWS_SECRET_ACCESS_KEY=
