# Principal
# --------------------
# APP_SECRET comes from this host's ".env-secrets"/".env-secrets.local" (DOCMOST_APP_SECRET).

# Database
# ----
DOCMOST_POSTGRESQL_USER=docmost
DOCMOST_POSTGRESQL_NAME=docmost
DOCMOST_POSTGRESQL_PASS=docmost # Dummy

# Cache
# ----
JWT_TOKEN_EXPIRES_IN=30d

# Storage
# ----
STORAGE_DRIVER=local

# Upload
# ----
FILE_UPLOAD_SIZE_LIMIT=256mb

# Mail
# ----
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=docmost@localhost.com
MAIL_FROM_NAME=Docmost

# SMTP
# ----
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORETLS=false



# Additional
# --------------------
DISABLE_TELEMETRY=true
